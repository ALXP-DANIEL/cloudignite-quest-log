{
  "manifest_version": 3,
  "name": "CloudIgnite Quest Log",
  "version": "1.4.4",
  "description": "A game-themed checklist for your AWS re/Start Canvas course.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://awsrestart.instructure.com/*",
    "https://labs.vocareum.com/*",
    "https://emergingtalent.contentcontroller.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://awsrestart.instructure.com/courses/4611",
        "https://awsrestart.instructure.com/courses/4611/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.vocareum.com/main/main.php*"
      ],
      "js": [
        "lab-celebration.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://emergingtalent.contentcontroller.com/*"
      ],
      "js": [
        "kc-celebration.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "Open your course quest log",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
