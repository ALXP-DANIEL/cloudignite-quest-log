{
  "manifest_version": 3,
  "name": "CloudIgnite Quest Log",
  "version": "1.1.0",
  "description": "A game-themed checklist for your AWS re/Start Canvas course.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://awsrestart.instructure.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://awsrestart.instructure.com/courses/4611/modules*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open your course quest log",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
